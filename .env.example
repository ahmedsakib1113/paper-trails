# Local development works without this file. To use Turso, copy to .env.
# Paste real values only into .env or Render's environment settings.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-your-database-token
PAPER_TRAILS_REQUIRE_TURSO=true

# For Render these values are already declared in render.yaml.
# Use COOKIE_SECURE=false for plain HTTP development on localhost.
HOST=127.0.0.1
COOKIE_SECURE=false
PAPER_TRAILS_DEMO=false
