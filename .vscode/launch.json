{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open Paper Trails",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "runtimeArgs": ["--env-file-if-exists=.env"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": { "pattern": "Paper Trails is open at (https?://[^\\s]+)", "uriFormat": "%s", "action": "openExternally" }
    }
  ]
}
